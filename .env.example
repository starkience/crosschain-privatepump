# RPC URLs. Keep real provider keys in .env.local (ignored by git).
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/REPLACE_ME
# The official STRK20 bridge uses the Starknet v0.10 `pre_confirmed` block tag.
STARKNET_SEPOLIA_RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/REPLACE_ME
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
STARKNET_MAINNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/starknet/version/rpc/v0_10/REPLACE_ME

# Official STRK20 services used by the same-origin browser proxy. Prover and
# indexer requests contain privacy-sensitive material and must not be sent
# directly to a credentialed upstream from production browser code.
STRK20_PROVER_URL=
STRK20_INDEXER_URL=
STRK20_MAINNET_PROVER_URL=https://transaction-prover.alpha-mainnet.sw-dev.io/
STRK20_MAINNET_INDEXER_URL=https://discovery-service.alpha-mainnet.sw-dev.io/

# Operator-approved Starkscan mainnet prover relay. The browser continues to
# call /prover/mainnet using the Privacy SDK's JSON-RPC shape; the server proxy
# adapts it to Starkscan's asynchronous jobs and keeps this key private.
STARKSCAN_PROVER_URL=https://api.starkscan.co/v1/SN_MAIN/prove
STARKSCAN_API_KEY=

# Durable Starkscan job cursor and short-lived encrypted one-time proof cache.
# Use an Upstash-compatible Redis REST endpoint. Generate the encryption key
# with `openssl rand -hex 32`; all three values stay server-side.
PROVER_STATE_REST_URL=
PROVER_STATE_REST_TOKEN=
PROVER_STATE_ENCRYPTION_KEY=

# AVNU's key remains server-side. The browser sends a non-secret placeholder to
# the same-origin proxy; the proxy overwrites it with this credential.
AVNU_PAYMASTER_URL=https://sepolia.paymaster.avnu.fi
AVNU_PAYMASTER_API_KEY=
PRIVATE_LAUNCHPAD_RELAYER_ORIGIN=http://127.0.0.1:18788
PORT=18788
RELAY_API_URL=https://api.relay.link
RELAY_API_KEY=
# Pons sell-return quotes older than this fail relayer policy validation.
RELAY_RETURN_MAX_QUOTE_AGE_SECONDS=900

# Public configuration consumed by the pinned official bridge module.
VITE_NETWORK=testnet
VITE_CCTP_FAST=true
VITE_OZ_ACCOUNT_CLASS_HASH_TESTNET=0x5b4b537eaa2399e3aa99c4e2e0208ebd6c71bc1467938cd52c798c601e43564
VITE_CCTP_DEFAULT_DEST_CHAIN_ID=84532
VITE_BASE_RPC_URL=/base-rpc
VITE_AVNU_PAYMASTER_URL=/api/avnu
VITE_AVNU_PAYMASTER_API_KEY=same-origin-proxy
VITE_PRIVATE_LAUNCHPAD_FACTORY=0xe674451F7D7067DF01Dd9A7109d9a47c6BAb620A
VITE_PRIVATE_LAUNCHPAD_RELAYER_URL=/api/private-launchpad/v1/relay
VITE_CLANKER_QUOTE_URL=/api/private-launchpad/v1/clanker/quote
VITE_CLANKER_BUILDER_ADDRESS=
# Optional pre-encoded Base builder-code suffix (ERC-8021 attribution).
VITE_BASE_BUILDER_CODE_SUFFIX=
# Set to live only after deploying the factory and starting the relayer.
VITE_RUNTIME_MODE=demo

# PrivatePons mainnet browser profile. It reuses the canonical Pons V2 factory;
# VITE_PRIVATE_LAUNCHPAD_FACTORY is our deterministic execution-account factory.
# VITE_LAUNCHPAD=pons
# VITE_NETWORK=mainnet
# VITE_CCTP_DEFAULT_DEST_CHAIN_ID=42161
# VITE_OZ_ACCOUNT_CLASS_HASH_MAINNET=0x5b4b537eaa2399e3aa99c4e2e0208ebd6c71bc1467938cd52c798c601e43564
# VITE_ROBINHOOD_RPC_URL=/robinhood-rpc
# VITE_ARBITRUM_RPC_URL=/arbitrum-rpc
# VITE_RELAY_BRIDGE_URL=/api/relay
# VITE_PRIVATE_LAUNCHPAD_FACTORY=0x_REPLACE_AFTER_ROBINHOOD_DEPLOY

# Optional source verification credential. Use a Foundry keystore for deployment.
BASESCAN_API_KEY=

# Relayer runtime.
CHAIN_ID=84532
# Must match the EIP-712 domain compiled into the deployed account factory.
EXECUTION_DOMAIN_NAME=PrivateLaunchpadAccount
RPC_URL=https://base-sepolia.g.alchemy.com/v2/REPLACE_ME
FACTORY_ADDRESS=0xe674451F7D7067DF01Dd9A7109d9a47c6BAb620A
RELAYER_PRIVATE_KEY=
RELAYER_FEE_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e
RELAYER_FEE_AMOUNT=0
RELAYER_FEE_RECIPIENT=
# Clanker V4, USDC, Circle TokenMessenger V2, and Plank's V4 swap helper.
ALLOWED_TARGETS=0xE85A59c628F7d27878ACeB4bf3b35733630083a9,0x036CbD53842c5426634e7929541ec2318f3dcf7e,0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA,0x63311261bc9eAe8c568418345C769ED3bf11154E
ALLOW_UNSAFE_ANY_TARGETS=false
# Allows only ERC-20 approve(helper, amount) on dynamic Clanker token targets.
ALLOW_UNISWAP_PROXY_APPROVALS=true
UNISWAP_PROXY_ADDRESS=0x63311261bc9eAe8c568418345C769ED3bf11154E
BASE_SEPOLIA_V4_SWAP_HELPER_ADDRESS=0x63311261bc9eAe8c568418345C769ED3bf11154E
# Optional overrides; defaults are the canonical deployed Base Sepolia addresses.
CLANKER_V4_FACTORY_ADDRESS=0xE85A59c628F7d27878ACeB4bf3b35733630083a9
BASE_SEPOLIA_V4_QUOTER_ADDRESS=0x4A6513c898fe1B2d0E78d3b0e0A4a151589B1cBa
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
UNISWAP_API_KEY=
# Optional for tests/self-hosted compatible gateways. Defaults to Uniswap's API.
UNISWAP_API_URL=
MAX_CALLS=16
MAX_CALLDATA_BYTES=65536
MAX_DEADLINE_SECONDS=900
MAX_PREFUND_WEI=0

# Robinhood/Pons V2 relayer profile (use in a separate deployment from Base).
# It semantically validates the current factory plus factory-recorded dynamic
# curve/token targets. The launch fee is 0.0005 ETH at the research snapshot;
# read it live and keep this prefund cap deliberately narrow.
# CHAIN_ID=4663
# EXECUTION_DOMAIN_NAME=PonsPrivacyAccount
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# PONS_V2_POLICY=true
# RELAY_API_KEY=REPLACE_WITH_SERVER_SIDE_KEY
# MAX_PREFUND_WEI=500000000000000

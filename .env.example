# RPC URLs. Keep real provider keys in .env.local (ignored by git).
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/REPLACE_ME
STARKNET_SEPOLIA_RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_8/REPLACE_ME

# Official STRK20 services used by the browser dev proxy. Prover and indexer
# requests contain privacy-sensitive material and must not be sent directly from
# a production browser. Production deployments need same-origin OHTTP gateways.
STRK20_PROVER_URL=
STRK20_INDEXER_URL=

# AVNU's key remains server-side. The browser sends a non-secret placeholder to
# the same-origin proxy; the proxy overwrites it with this credential.
AVNU_PAYMASTER_URL=https://sepolia.paymaster.avnu.fi
AVNU_PAYMASTER_API_KEY=

# Public configuration consumed by the pinned official bridge module.
VITE_NETWORK=testnet
VITE_OZ_ACCOUNT_CLASS_HASH_TESTNET=0x5b4b537eaa2399e3aa99c4e2e0208ebd6c71bc1467938cd52c798c601e43564
VITE_CCTP_DEFAULT_DEST_CHAIN_ID=84532
VITE_BASE_RPC_URL=/base-rpc
VITE_AVNU_PAYMASTER_URL=/api/avnu
VITE_AVNU_PAYMASTER_API_KEY=same-origin-proxy
VITE_PRIVATE_LAUNCHPAD_FACTORY=
VITE_PRIVATE_LAUNCHPAD_RELAYER_URL=/api/private-launchpad/v1/relay

# Optional source verification credential. Use a Foundry keystore for deployment.
BASESCAN_API_KEY=

# Relayer runtime.
CHAIN_ID=84532
RPC_URL=https://base-sepolia.g.alchemy.com/v2/REPLACE_ME
FACTORY_ADDRESS=
RELAYER_PRIVATE_KEY=
RELAYER_FEE_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e
RELAYER_FEE_AMOUNT=0
RELAYER_FEE_RECIPIENT=
# Clanker v3.1, USDC, and Circle TokenMessenger V2 on Base Sepolia.
ALLOWED_TARGETS=0x2A787b2362021cC3eEa3C24C4748a6cD5B687382,0x036CbD53842c5426634e7929541eC2318f3dCF7e,0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
ALLOW_UNSAFE_ANY_TARGETS=false
MAX_CALLS=16
MAX_CALLDATA_BYTES=65536
MAX_DEADLINE_SECONDS=900
MAX_PREFUND_WEI=0
